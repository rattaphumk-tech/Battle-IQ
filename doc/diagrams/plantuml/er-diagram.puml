@startuml er-diagram
!pragma layout smetana
skinparam defaultFontName Tahoma
skinparam linetype ortho
hide circle
title Battle IQ - ER Diagram (PostgreSQL)

entity "users" as users {
    *id : bigint <<PK>>
    --
    *username : varchar(50) <<UK>>
    *email : varchar(100) <<UK>>
    *password : varchar(255)
    created_at : timestamp
}
entity "user_profiles" as profiles {
    *user_id : bigint <<PK,FK>>
    --
    full_name : varchar(255)
    avatar_url : varchar(255)
    total_score : integer
    level : integer
    current_streak : integer
}
entity "categories" as categories {
    *id : bigint <<PK>>
    --
    *name : varchar(100) <<UK>>
    description : varchar(255)
}
entity "questions" as questions {
    *id : bigint <<PK>>
    --
    *category_id : bigint <<FK>>
    *question_text : text
    *optiona..optiond : varchar(255)
    *correct_answer : varchar(1)
    time_limit_seconds : integer
}
entity "quiz_sessions" as sessions {
    *id : bigint <<PK>>
    --
    *user_id : bigint <<FK>>
    *category_id : bigint <<FK>>
    total_questions : integer
    total_score : integer
    *status : varchar(255)
    created_at : timestamp
    completed_at : timestamp
}
entity "quiz_details" as details {
    *id : bigint <<PK>>
    --
    *session_id : bigint <<FK>>
    *question_id : bigint <<FK>>
    user_ans : varchar(255)
    is_correct : boolean
    time_taken_seconds : integer
    score_earned : integer
}
entity "rooms" as rooms {
    *id : bigint <<PK>>
    --
    *code : varchar(6) <<UK>>
    *host_id : bigint <<FK>>
    *category_id : bigint <<FK>>
    *status : varchar(20)
    created_at : timestamp
    started_at : timestamp
}
entity "room_players" as players {
    *id : bigint <<PK>>
    --
    *room_id : bigint <<FK>>
    *user_id : bigint <<FK>>
    session_id : bigint <<FK>>
    joined_at : timestamp
}

users ||--|| profiles
users ||--o{ sessions
users ||--o{ rooms : host
users ||--o{ players
rooms ||--o{ players
categories ||--o{ rooms
categories ||--o{ questions
categories ||--o{ sessions
sessions ||--o{ details
questions ||--o{ details
sessions |o--o| players
@enduml
