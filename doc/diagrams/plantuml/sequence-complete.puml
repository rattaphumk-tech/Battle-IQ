@startuml sequence-complete
skinparam defaultFontName Tahoma
title Sequence 3 - จบเกมและอัปเดตโปรไฟล์ (Observer)

actor "ผู้เล่น" as P
participant "play.html" as V
participant "QuizSessionController" as C
participant "QuizSessionServiceImpl" as S
participant "QuizSessionRepository" as SR
participant "ApplicationEventPublisher" as PUB
participant "GameCompletionEventListener" as L
participant "UserProfileServiceImpl" as PS
participant "UserProfileRepository" as PR

P -> V : กด "ดูผลคะแนน"
V -> C : POST /quiz-sessions/{id}/complete
C -> S : completeSession(id)
S -> SR : findById(id)
SR --> S : QuizSession + details
alt status != IN_PROGRESS
    S --> C : ConflictException (409)
end
S -> S : totalScore = Σ scoreEarned
S -> S : status = COMPLETED
S -> SR : save(session)
S -> PUB : publishEvent(GameCompletedEvent)
PUB -> L : onGameCompleted(event)
L -> PS : applyGameResult(userId, totalScore)
PS -> PR : findByUserId(userId)
PR --> PS : UserProfile
PS -> PS : totalScore += score\nlevel = total/100+1\nstreak +1 หรือ 0
PS -> PR : save(profile)
PS --> L : done
L --> PUB : done
S --> C : QuizSessionResponseDTO
C --> V : 200
V --> P : ไปหน้า /result (หรือ /room)
@enduml
