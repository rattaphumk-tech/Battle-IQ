@startuml activity-room
skinparam defaultFontName Tahoma
title Activity 2 - แข่งในห้อง (หลายคน)

start
if (สร้างหรือเข้าร่วม?) then (สร้าง)
    :เลือกหมวด POST /rooms;
    :ได้รหัส 6 ตัว เป็นเจ้าของห้อง;
else (เข้าร่วม)
    :ใส่รหัส POST /rooms/{code}/join;
    if (ห้อง WAITING และไม่เต็ม?) then (ไม่)
        :409 แสดงข้อความ;
        stop
    endif
endif
repeat
    :หน้าห้อง polling ทุก 2 วินาที;
    switch (สถานะห้อง)
    case (WAITING)
        if (เจ้าของ และผู้เล่น >= 2?) then (ใช่)
            :กดเริ่มแข่ง POST /start;
            :สุ่มคำถาม 1 ชุด
            สร้าง session ให้ทุกคน;
        endif
    case (IN_PROGRESS)
        if (session ของฉันยังไม่จบ?) then (ใช่)
            :ไป /play?session=..&room=CODE;
            :เล่นตาม Activity 1;
            :จบเกม กลับหน้าห้อง;
        else (จบแล้ว)
            :ดูอันดับสด รอคนอื่น;
        endif
    case (FINISHED)
        :แสดงอันดับสุดท้าย;
    endswitch
repeat while (ห้องยังไม่ FINISHED?) is (ใช่) not (จบ)
stop
@enduml
