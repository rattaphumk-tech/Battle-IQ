@startuml sequence-answer
skinparam defaultFontName Tahoma
title Sequence 2 - ตอบคำถาม 1 ข้อ (Command + Strategy)

actor "ผู้เล่น" as P
participant "play.html" as V
participant "AnswerController" as C
participant "AnswerServiceImpl" as S
participant "QuizDetailRepository" as DR
participant "UserProfileRepository" as PR
participant "SubmitAnswerCommand" as CMD
participant "ScoringStrategySelector" as SEL
participant "ScoringStrategy" as ST

P -> V : กดตัวเลือก B
V -> V : หยุดเวลา คำนวณ timeTaken
V -> C : POST /quiz-sessions/{id}/answers
C -> S : submitAnswer(sessionId, dto)
S -> DR : findByQuizSessionIdAndQuestionId
DR --> S : QuizDetail
alt session ไม่ใช่ IN_PROGRESS
    S --> C : ConflictException (409)
end
S -> PR : findByUserId(userId)
PR --> S : currentStreak
S -> CMD : new SubmitAnswerCommand(...)
S -> CMD : execute()
alt ตอบข้อนี้ไปแล้ว
    CMD --> S : ConflictException (409)
end
CMD -> CMD : correct = correctAnswer == "B"
opt ตอบถูก
    CMD -> SEL : select(question, streak)
    SEL --> CMD : strategy
    CMD -> ST : calculate(question, timeTaken, streak)
    ST --> CMD : score
end
CMD -> CMD : บันทึก userAns / isCorrect / scoreEarned
CMD --> S : AnswerResultDTO
S -> DR : save(detail)
S --> C : AnswerResultDTO
C --> V : 200
V --> P : ไฮไลต์เฉลย แสดงคะแนน
@enduml
